<Project Sdk="WixToolset.Sdk/5.0.2" ToolsVersion="4.0">
  <PropertyGroup>
    <OutputName>IntegrationSoup.HtmlToPdfActivities</OutputName>
    <IncludeSearchPaths>$(MSBuildProjectDirectory)</IncludeSearchPaths>
    <InstallerPlatform>x86</InstallerPlatform>

    <CustomActivitiesTargetDir>$(MSBuildProjectDirectory)\..\HtmlToPdfActivities\bin\$(Configuration)\net48\</CustomActivitiesTargetDir>
    <RendererTargetDir>$(CustomActivitiesTargetDir)HtmlToPdfRenderer\</RendererTargetDir>

    <GeneratedInstallerVersionFile>$(BaseIntermediateOutputPath)$(Configuration)\GeneratedInstallerVersion.wxi</GeneratedInstallerVersionFile>
    <InstallerVersionCounterFile Condition="'$(InstallerVersionCounterFile)' == ''">$(LocalAppData)\Popokey\InstallerBuildCounters\HtmlToPdfActivities.counter</InstallerVersionCounterFile>

    <DefineConstants>
      $(DefineConstants);
      HtmlToPdfActivitiesTargetDir=$(CustomActivitiesTargetDir);
      HtmlToPdfRendererTargetDir=$(RendererTargetDir);
      GeneratedInstallerVersionFile=$(MSBuildProjectDirectory)\$(GeneratedInstallerVersionFile)
    </DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <SigntoolPath Condition="'$(SigntoolPath)' == ''">C:\Program Files (x86)\Windows Kits\10\bin\$(WindowsTargetPlatformVersion)\x64\signtool.exe</SigntoolPath>
    <CodeSignThumbprint>1586FB787BD45270D870F90918EF887A121EB6DB</CodeSignThumbprint>
    <TimestampUrl>http://ts.ssl.com</TimestampUrl>
  </PropertyGroup>

  <Target Name="GenerateInstallerVersion" BeforeTargets="BeforeBuild">
    <MakeDir Directories="$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)$(Configuration)\" />
    <Exec Command="&quot;$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\GenerateInstallerVersion.ps1&quot; -CounterFile &quot;$(InstallerVersionCounterFile)&quot; -OutputFile &quot;$(MSBuildProjectDirectory)\$(GeneratedInstallerVersionFile)&quot; -InstallerVersion &quot;$(InstallerVersion)&quot;" />
  </Target>

  <Target Name="ValidateHtmlToPdfArtifacts" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(CustomActivitiesTargetDir)HtmlToPdfActivities.dll')"
           Text="Missing staged file '$(CustomActivitiesTargetDir)HtmlToPdfActivities.dll'. Build HtmlToPdfActivities for net48 before building the installer." />
    <Error Condition="!Exists('$(RendererTargetDir)HtmlToPdfRenderer.exe')"
           Text="Missing staged file '$(RendererTargetDir)HtmlToPdfRenderer.exe'. Build HtmlToPdfActivities for net48 before building the installer." />
  </Target>

  <Target Name="SignPayloads"
          AfterTargets="ResolveReferences"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_Sign Include="$(CustomActivitiesTargetDir)HtmlToPdfActivities.dll" />
      <_Sign Include="$(RendererTargetDir)HtmlToPdfRenderer.exe" />
    </ItemGroup>

    <Exec Condition="'@(_Sign)' != ''"
          Command="&quot;$(SigntoolPath)&quot; sign /v /fd SHA256 /td SHA256 /tr &quot;$(TimestampUrl)&quot; /sha1 $(CodeSignThumbprint) @(_Sign->'&quot;%(Identity)&quot;', ' ')" />
  </Target>

  <Target Name="SignMsiOutput"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_Msi Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\**\*.msi" />
    </ItemGroup>

    <Exec Condition="'@(_Msi)' != ''"
          Command="&quot;$(SigntoolPath)&quot; sign /v /fd SHA256 /td SHA256 /d &quot;Integration Soup HTML to PDF Extension Library&quot; /tr &quot;$(TimestampUrl)&quot; /sha1 $(CodeSignThumbprint) @(_Msi->'&quot;%(Identity)&quot;', ' ')" />
  </Target>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.*" />
  </ItemGroup>

  <ItemGroup>
    <Wix Include="**\*.wxs" />
    <None Include="ProductVariables.wxi" />
    <None Include="GenerateInstallerVersion.ps1" />
  </ItemGroup>
</Project>
