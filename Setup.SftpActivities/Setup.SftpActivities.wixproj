<Project Sdk="WixToolset.Sdk/5.0.2" ToolsVersion="4.0">
  <PropertyGroup>
    <OutputName>IntegrationSoup.SftpActivities</OutputName>
    <IncludeSearchPaths>$(MSBuildProjectDirectory)</IncludeSearchPaths>
    <InstallerPlatform>x86</InstallerPlatform>

    <ActivitySourceDir>$(MSBuildProjectDirectory)\..\SftpActivities\bin\$(Configuration)\net48\</ActivitySourceDir>
    <RunnerSourceDir>$(ActivitySourceDir)SftpActivitiesRunner\</RunnerSourceDir>
    <MainAssemblyPath>$(ActivitySourceDir)SftpActivities.dll</MainAssemblyPath>
    <RunnerExecutablePath>$(RunnerSourceDir)SftpActivitiesRunner.exe</RunnerExecutablePath>
    <WinScpExecutablePath>$(RunnerSourceDir)WinSCP.exe</WinScpExecutablePath>
    <WinScpNetAssemblyPath>$(RunnerSourceDir)WinSCPnet.dll</WinScpNetAssemblyPath>

    <GeneratedInstallerVersionFile>$(BaseIntermediateOutputPath)$(Configuration)\GeneratedInstallerVersion.wxi</GeneratedInstallerVersionFile>
    <InstallerVersionCounterFile Condition="'$(InstallerVersionCounterFile)' == ''">$(LocalAppData)\Popokey\InstallerBuildCounters\SftpActivities.counter</InstallerVersionCounterFile>
    <VersionScriptPath>$(MSBuildProjectDirectory)\..\InstallerTools\GenerateInstallerVersion.ps1</VersionScriptPath>

    <DefineConstants>
      $(DefineConstants);
      ActivitySourceDir=$(ActivitySourceDir);
      RunnerSourceDir=$(RunnerSourceDir);
      GeneratedInstallerVersionFile=$(MSBuildProjectDirectory)\$(GeneratedInstallerVersionFile)
    </DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <SigntoolPath Condition="'$(SigntoolPath)' == ''">C:\Program Files (x86)\Windows Kits\10\bin\$(WindowsTargetPlatformVersion)\x64\signtool.exe</SigntoolPath>
    <CodeSignThumbprint>1586FB787BD45270D870F90918EF887A121EB6DB</CodeSignThumbprint>
    <TimestampUrl>http://ts.ssl.com</TimestampUrl>
  </PropertyGroup>

  <Target Name="GenerateInstallerVersion" BeforeTargets="BeforeBuild">
    <MakeDir Directories="$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)$(Configuration)\" />
    <Exec Command="&quot;$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -ExecutionPolicy Bypass -File &quot;$(VersionScriptPath)&quot; -CounterFile &quot;$(InstallerVersionCounterFile)&quot; -OutputFile &quot;$(MSBuildProjectDirectory)\$(GeneratedInstallerVersionFile)&quot; -InstallerVersion &quot;$(InstallerVersion)&quot;" />
  </Target>

  <Target Name="ValidatePayload" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(MainAssemblyPath)')"
           Text="Missing staged file '$(MainAssemblyPath)'. Build SftpActivities before building the installer." />
    <Error Condition="!Exists('$(RunnerExecutablePath)')"
           Text="Missing staged file '$(RunnerExecutablePath)'. Build SftpActivities for net48 before building the installer." />
    <Error Condition="!Exists('$(WinScpExecutablePath)')"
           Text="Missing staged file '$(WinScpExecutablePath)'. Build SftpActivities for net48 before building the installer." />
    <Error Condition="!Exists('$(WinScpNetAssemblyPath)')"
           Text="Missing staged file '$(WinScpNetAssemblyPath)'. Build SftpActivities for net48 before building the installer." />
  </Target>

  <Target Name="SignPayloads"
          AfterTargets="ResolveReferences"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_Sign Include="$(MainAssemblyPath)" />
      <_Sign Include="$(RunnerExecutablePath)" />
    </ItemGroup>

    <Exec Condition="'@(_Sign)' != ''"
          Command="&quot;$(SigntoolPath)&quot; sign /v /fd SHA256 /td SHA256 /tr &quot;$(TimestampUrl)&quot; /sha1 $(CodeSignThumbprint) @(_Sign->'&quot;%(Identity)&quot;', ' ')" />
  </Target>

  <Target Name="SignMsiOutput"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_Msi Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\**\*.msi" />
    </ItemGroup>

    <Exec Condition="'@(_Msi)' != ''"
          Command="&quot;$(SigntoolPath)&quot; sign /v /fd SHA256 /td SHA256 /d &quot;Integration Soup SFTP Activities Extension Library&quot; /tr &quot;$(TimestampUrl)&quot; /sha1 $(CodeSignThumbprint) @(_Msi->'&quot;%(Identity)&quot;', ' ')" />
  </Target>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.*" />
  </ItemGroup>

  <ItemGroup>
    <Wix Include="**\*.wxs" />
    <None Include="ProductVariables.wxi" />
    <None Include="..\InstallerTools\GenerateInstallerVersion.ps1" Link="GenerateInstallerVersion.ps1" />
  </ItemGroup>
</Project>
