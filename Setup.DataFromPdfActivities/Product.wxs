<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <?include $(var.ProjectDir)ProductVariables.wxi ?>
  <?include $(var.GeneratedInstallerVersionFile) ?>

  <Package Name="$(var.ProductDisplayName)"
           Language="1033"
           Version="$(var.InstallerVersion)"
           Manufacturer="$(var.CompanyName)"
           UpgradeCode="$(var.UpgradeCode)"
           ProductCode="*"
           Scope="perMachine"
           InstallerVersion="500"
           ShortNames="no">

    <SummaryInformation Description="$(var.ProductDisplayName) $(var.ProductVersionString)"
                        Keywords="Integration Soup, Extension Library, Installer, PDF, JSON, Data" />

    <Media Id="1" Cabinet="media1.cab" EmbedCab="yes" />

    <Property Id="MSIUSEREALADMINDETECTION" Value="1" />
    <Property Id="ARPCOMMENTS" Value="$(var.ProductDescription) $(var.ProductVersionString)" />

    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <?include $(var.ProjectDir)..\InstallerTools\RequireNetFramework48.wxi ?>

    <CustomActionRef Id="CaptureHostServices" />

    <Property Id="INTEGRATIONSOUPSERVICEFOUND">
      <RegistrySearch Id="FindIntegrationSoupHostService"
                      Root="HKLM"
                      Key="SYSTEM\CurrentControlSet\Services\IntegrationSoupHostService"
                      Name="ImagePath"
                      Type="raw" />
    </Property>

    <Property Id="LEGACYINTEGRATIONSOUPSERVICEFOUND">
      <RegistrySearch Id="FindLegacyIntegrationSoupHostService"
                      Root="HKLM"
                      Key="SYSTEM\CurrentControlSet\Services\HL7SoupIntegrationHostServer"
                      Name="ImagePath"
                      Type="raw" />
    </Property>

    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="COMPANYFOLDER" Name="$(var.CompanyName)">
        <Directory Id="SERVERAPPLICATIONFOLDER" Name="$(var.IntegrationHostServerFolderName)">
          <Directory Id="SERVERCUSTOMLIBRARIESFOLDER" Name="$(var.CustomLibrariesFolderName)">
            <Directory Id="SERVERRUNNERFOLDER" Name="$(var.RunnerFolderName)" />
          </Directory>
        </Directory>
        <Directory Id="SOUPAPPLICATIONFOLDER" Name="$(var.HL7SoupFolderName)">
          <Directory Id="SOUPCUSTOMLIBRARIESFOLDER" Name="$(var.CustomLibrariesFolderName)" />
        </Directory>
        <Directory Id="WORKFLOWDESIGNERAPPLICATIONFOLDER" Name="$(var.IntegrationWorkflowDesignerFolderName)">
          <Directory Id="WORKFLOWDESIGNERCUSTOMLIBRARIESFOLDER" Name="$(var.CustomLibrariesFolderName)" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature"
             Title="Data from PDF"
             Description="$(var.ProductDescription)"
             Level="1"
             AllowAdvertise="no"
             AllowAbsent="yes">
      <ComponentRef Id="ServerActivityDllComponent" />
      <ComponentGroupRef Id="RunnerComponents" />
      <ComponentRef Id="ServerServiceRestartComponent" />
      <ComponentRef Id="LegacyServerServiceRestartComponent" />
      <ComponentRef Id="SoupActivityDllComponent" />
      <ComponentRef Id="WorkflowDesignerActivityDllComponent" />
      <ComponentGroupRef Id="BridgeProviderComponents" />
      <ComponentRef Id="LegacyRunnerBridgeJson" />
    </Feature>

    <ComponentGroup Id="RunnerComponents">
      <ComponentRef Id="RunnerExecutableComponent" />
      <ComponentRef Id="RunnerConfigComponent" />
      <ComponentRef Id="UglyToadPdfPigComponent" />
      <ComponentRef Id="UglyToadPdfPigCoreComponent" />
      <ComponentRef Id="UglyToadPdfPigDocumentLayoutAnalysisComponent" />
      <ComponentRef Id="UglyToadPdfPigFontsComponent" />
      <ComponentRef Id="UglyToadPdfPigPackageComponent" />
      <ComponentRef Id="UglyToadPdfPigTokenizationComponent" />
      <ComponentRef Id="UglyToadPdfPigTokensComponent" />
      <ComponentRef Id="MicrosoftBclHashCodeComponent" />
      <ComponentRef Id="SystemMemoryComponent" />
      <ComponentRef Id="SystemRuntimeCompilerServicesUnsafeComponent" />
      <ComponentRef Id="SystemBuffersComponent" />
      <ComponentRef Id="SystemNumericsVectorsComponent" />
    </ComponentGroup>

    <DirectoryRef Id="SERVERCUSTOMLIBRARIESFOLDER">
      <Component Bitness="always32" Id="ServerActivityDllComponent" Guid="{3122CBEB-4952-4747-95FF-B06E6A8B0301}">
        <File Id="ServerActivityDllFile"
              Name="$(var.ActivityFileName)"
              Source="$(var.ActivitySourceDir)$(var.ActivityFileName)"
              KeyPath="yes" />
      </Component>

      <Component Bitness="always32" Id="ServerServiceRestartComponent"
                 Guid="{DAEA53D4-F157-4EA6-8144-8B2C2E92BBBF}"
                 Condition="INTEGRATIONSOUPSERVICEFOUND">
        <RegistryValue Root="HKLM"
                       Key="Software\Popokey\DataFromPdfActivities"
                       Name="ServiceRestartMarker"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <Component Bitness="always32" Id="LegacyServerServiceRestartComponent"
                 Guid="{B1CFECBB-EE19-4486-837D-AF2F0737DF76}"
                 Condition="LEGACYINTEGRATIONSOUPSERVICEFOUND">
        <RegistryValue Root="HKLM"
                       Key="Software\Popokey\DataFromPdfActivities"
                       Name="LegacyServiceRestartMarker"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="SERVERRUNNERFOLDER">
      <Component Bitness="always32" Id="RunnerExecutableComponent" Guid="{924780B0-990F-499C-BA0B-4AC30F33103B}">
        <File Id="RunnerExecutableFile"
              Name="$(var.RunnerExecutableName)"
              Source="$(var.RunnerSourceDir)$(var.RunnerExecutableName)"
              KeyPath="yes" />
      </Component>

      <Component Bitness="always32" Id="RunnerConfigComponent" Guid="{33FE0AFD-FD4C-4553-B193-E54DD43527EC}">
        <File Id="RunnerConfigFile"
              Name="$(var.RunnerConfigFileName)"
              Source="$(var.RunnerSourceDir)$(var.RunnerConfigFileName)"
              KeyPath="yes" />
      </Component>

      <Component Bitness="always32" Id="UglyToadPdfPigComponent" Guid="{8ECF962A-EFFA-4C60-B935-5EDFF0994893}">
        <File Id="UglyToadPdfPigFile"
              Name="UglyToad.PdfPig.dll"
              Source="$(var.RunnerSourceDir)UglyToad.PdfPig.dll"
              KeyPath="yes" />
      </Component>

      <Component Bitness="always32" Id="UglyToadPdfPigCoreComponent" Guid="{1831274D-33B2-48DA-9108-4756E7855354}">
        <File Id="UglyToadPdfPigCoreFile"
              Name="UglyToad.PdfPig.Core.dll"
              Source="$(var.RunnerSourceDir)UglyToad.PdfPig.Core.dll"
              KeyPath="yes" />
      </Component>

      <Component Bitness="always32" Id="UglyToadPdfPigDocumentLayoutAnalysisComponent" Guid="{94A8CBFD-48E7-4E29-B1C2-E74E30010914}">
        <File Id="UglyToadPdfPigDocumentLayoutAnalysisFile"
              Name="UglyToad.PdfPig.DocumentLayoutAnalysis.dll"
              Source="$(var.RunnerSourceDir)UglyToad.PdfPig.DocumentLayoutAnalysis.dll"
              KeyPath="yes" />
      </Component>

      <Component Bitness="always32" Id="UglyToadPdfPigFontsComponent" Guid="{F2DA16C2-1A59-4053-9FF1-17582841B230}">
        <File Id="UglyToadPdfPigFontsFile"
              Name="UglyToad.PdfPig.Fonts.dll"
              Source="$(var.RunnerSourceDir)UglyToad.PdfPig.Fonts.dll"
              KeyPath="yes" />
      </Component>

      <Component Bitness="always32" Id="UglyToadPdfPigPackageComponent" Guid="{F91D737A-A279-457C-95A7-2AF7648D46E1}">
        <File Id="UglyToadPdfPigPackageFile"
              Name="UglyToad.PdfPig.Package.dll"
              Source="$(var.RunnerSourceDir)UglyToad.PdfPig.Package.dll"
              KeyPath="yes" />
      </Component>

      <Component Bitness="always32" Id="UglyToadPdfPigTokenizationComponent" Guid="{BB6A3487-FA55-43BE-BAA6-AD944B8B1DA8}">
        <File Id="UglyToadPdfPigTokenizationFile"
              Name="UglyToad.PdfPig.Tokenization.dll"
              Source="$(var.RunnerSourceDir)UglyToad.PdfPig.Tokenization.dll"
              KeyPath="yes" />
      </Component>

      <Component Bitness="always32" Id="UglyToadPdfPigTokensComponent" Guid="{738F1D5B-8710-4928-866D-671A51E6428C}">
        <File Id="UglyToadPdfPigTokensFile"
              Name="UglyToad.PdfPig.Tokens.dll"
              Source="$(var.RunnerSourceDir)UglyToad.PdfPig.Tokens.dll"
              KeyPath="yes" />
      </Component>

      <Component Bitness="always32" Id="MicrosoftBclHashCodeComponent" Guid="{783A9521-461A-4114-B59C-A9AD5F12B1BC}">
        <File Id="MicrosoftBclHashCodeFile"
              Name="Microsoft.Bcl.HashCode.dll"
              Source="$(var.RunnerSourceDir)Microsoft.Bcl.HashCode.dll"
              KeyPath="yes" />
      </Component>

      <Component Bitness="always32" Id="SystemMemoryComponent" Guid="{772C29D8-2E19-49C7-8EE5-010B55122A50}">
        <File Id="SystemMemoryFile"
              Name="System.Memory.dll"
              Source="$(var.RunnerSourceDir)System.Memory.dll"
              KeyPath="yes" />
      </Component>

      <Component Bitness="always32" Id="SystemRuntimeCompilerServicesUnsafeComponent" Guid="{4839DCC1-9A97-4551-9E7B-28073D4B7F43}">
        <File Id="SystemRuntimeCompilerServicesUnsafeFile"
              Name="System.Runtime.CompilerServices.Unsafe.dll"
              Source="$(var.RunnerSourceDir)System.Runtime.CompilerServices.Unsafe.dll"
              KeyPath="yes" />
      </Component>

      <Component Bitness="always32" Id="SystemBuffersComponent" Guid="{0864BE38-1ADB-43D0-BD02-E4C48DD52030}">
        <File Id="SystemBuffersFile"
              Name="System.Buffers.dll"
              Source="$(var.RunnerSourceDir)System.Buffers.dll"
              KeyPath="yes" />
      </Component>

      <Component Bitness="always32" Id="SystemNumericsVectorsComponent" Guid="{FEFCB66D-A731-4579-94FC-75FDA3CB327C}">
        <File Id="SystemNumericsVectorsFile"
              Name="System.Numerics.Vectors.dll"
              Source="$(var.RunnerSourceDir)System.Numerics.Vectors.dll"
              KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="SOUPCUSTOMLIBRARIESFOLDER">
      <Component Bitness="always32" Id="SoupActivityDllComponent" Guid="{30E3052B-1EC5-4797-9AB9-9120902B6725}">
        <File Id="SoupActivityDllFile"
              Name="$(var.ActivityFileName)"
              Source="$(var.ActivitySourceDir)$(var.ActivityFileName)"
              KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="WORKFLOWDESIGNERCUSTOMLIBRARIESFOLDER">
      <Component Bitness="always32" Id="WorkflowDesignerActivityDllComponent" Guid="{BC75E9D7-2D64-4A38-89D6-6AB08C8207BF}">
        <File Id="WorkflowDesignerActivityDllFile"
              Name="$(var.ActivityFileName)"
              Source="$(var.ActivitySourceDir)$(var.ActivityFileName)"
              KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="SERVERRUNNERFOLDER">
      <Component Id="LegacyRunnerBridgeJson" Guid="*" Bitness="always32">
        <File Source="$(var.BridgePayloadSource)Newtonsoft.Json.dll" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Package>
</Wix>
