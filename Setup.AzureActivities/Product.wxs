<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <?include $(var.ProjectDir)ProductVariables.wxi ?>
  <?include $(var.GeneratedInstallerVersionFile) ?>

  <Package Name="$(var.ProductDisplayName)"
           Language="1033"
           Version="$(var.InstallerVersion)"
           Manufacturer="$(var.CompanyName)"
           UpgradeCode="$(var.UpgradeCode)"
           ProductCode="*"
           Scope="perMachine"
           InstallerVersion="500"
           ShortNames="no">

    <SummaryInformation Description="$(var.ProductDisplayName) $(var.ProductVersionString)"
                        Keywords="Integration Soup, Extension Library, Installer, Azure" />

    <Media Id="1" Cabinet="media1.cab" EmbedCab="yes" />

    <Property Id="MSIUSEREALADMINDETECTION" Value="1" />
    <Property Id="ARPCOMMENTS" Value="$(var.ProductDescription) $(var.ProductVersionString)" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <Property Id="INTEGRATIONSOUPSERVICEFOUND">
      <RegistrySearch Id="FindIntegrationSoupHostService"
                      Root="HKLM"
                      Key="SYSTEM\CurrentControlSet\Services\IntegrationSoupHostService"
                      Type="raw" />
    </Property>

    <Property Id="LEGACYINTEGRATIONSOUPSERVICEFOUND">
      <RegistrySearch Id="FindLegacyIntegrationSoupHostService"
                      Root="HKLM"
                      Key="SYSTEM\CurrentControlSet\Services\HL7SoupIntegrationHostServer"
                      Type="raw" />
    </Property>

    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="COMPANYFOLDER" Name="$(var.CompanyName)">
        <Directory Id="SERVERAPPLICATIONFOLDER" Name="$(var.IntegrationHostServerFolderName)">
          <Directory Id="SERVERCUSTOMLIBRARIESFOLDER" Name="$(var.CustomLibrariesFolderName)" />
        </Directory>
        <Directory Id="SOUPAPPLICATIONFOLDER" Name="$(var.HL7SoupFolderName)">
          <Directory Id="SOUPCUSTOMLIBRARIESFOLDER" Name="$(var.CustomLibrariesFolderName)" />
        </Directory>
        <Directory Id="WORKFLOWDESIGNERAPPLICATIONFOLDER" Name="$(var.IntegrationWorkflowDesignerFolderName)">
          <Directory Id="WORKFLOWDESIGNERCUSTOMLIBRARIESFOLDER" Name="$(var.CustomLibrariesFolderName)" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature"
             Title="$(var.ProductDisplayName)"
             Description="$(var.ProductDescription)"
             Level="1"
             AllowAdvertise="no"
             AllowAbsent="yes">
      <ComponentGroupRef Id="PayloadComponents" />
      <ComponentRef Id="ServerServiceRestartComponent" />
      <ComponentRef Id="LegacyServerServiceRestartComponent" />
    </Feature>

    <ComponentGroup Id="PayloadComponents">
      <ComponentRef Id="AzureCoreComponent" />
      <ComponentRef Id="AzureStorageBlobsComponent" />
      <ComponentRef Id="AzureStorageCommonComponent" />
      <ComponentRef Id="AzureActivitiesComponent" />
      <ComponentRef Id="MicrosoftBclAsyncInterfacesComponent" />
      <ComponentRef Id="SystemBuffersComponent" />
      <ComponentRef Id="SystemConfigurationConfigurationManagerComponent" />
      <ComponentRef Id="SystemDiagnosticsDiagnosticSourceComponent" />
      <ComponentRef Id="SystemIoHashingComponent" />
      <ComponentRef Id="SystemMemoryDataComponent" />
      <ComponentRef Id="SystemMemoryComponent" />
      <ComponentRef Id="SystemNumericsVectorsComponent" />
      <ComponentRef Id="SystemRuntimeCompilerServicesUnsafeComponent" />
      <ComponentRef Id="SystemTextEncodingsWebComponent" />
      <ComponentRef Id="SystemTextJsonComponent" />
      <ComponentRef Id="SystemThreadingTasksExtensionsComponent" />
    </ComponentGroup>

    <DirectoryRef Id="SERVERCUSTOMLIBRARIESFOLDER">
      <Component Id="AzureCoreComponent"
                 Guid="{714232F2-C06B-4692-9201-C771B83191E0}">
        <File Id="AzureCoreFile"
              Name="Azure.Core.dll"
              Source="$(var.PayloadSourceDir)Azure.Core.dll"
              KeyPath="yes">
          <CopyFile Id="CopyAzureCoreToSoup"
                    DestinationDirectory="SOUPCUSTOMLIBRARIESFOLDER" />
          <CopyFile Id="CopyAzureCoreToWorkflowDesigner"
                    DestinationDirectory="WORKFLOWDESIGNERCUSTOMLIBRARIESFOLDER" />
        </File>
      </Component>

      <Component Id="AzureStorageBlobsComponent"
                 Guid="{716A3A9E-D427-44AC-8B71-962905FE276C}">
        <File Id="AzureStorageBlobsFile"
              Name="Azure.Storage.Blobs.dll"
              Source="$(var.PayloadSourceDir)Azure.Storage.Blobs.dll"
              KeyPath="yes">
          <CopyFile Id="CopyAzureStorageBlobsToSoup"
                    DestinationDirectory="SOUPCUSTOMLIBRARIESFOLDER" />
          <CopyFile Id="CopyAzureStorageBlobsToWorkflowDesigner"
                    DestinationDirectory="WORKFLOWDESIGNERCUSTOMLIBRARIESFOLDER" />
        </File>
      </Component>

      <Component Id="AzureStorageCommonComponent"
                 Guid="{62CFC96F-C9BE-456E-9E1C-CB4D835B884D}">
        <File Id="AzureStorageCommonFile"
              Name="Azure.Storage.Common.dll"
              Source="$(var.PayloadSourceDir)Azure.Storage.Common.dll"
              KeyPath="yes">
          <CopyFile Id="CopyAzureStorageCommonToSoup"
                    DestinationDirectory="SOUPCUSTOMLIBRARIESFOLDER" />
          <CopyFile Id="CopyAzureStorageCommonToWorkflowDesigner"
                    DestinationDirectory="WORKFLOWDESIGNERCUSTOMLIBRARIESFOLDER" />
        </File>
      </Component>

      <Component Id="AzureActivitiesComponent"
                 Guid="{BDB3FAE1-21EF-486D-9A68-F24BF96E9F50}">
        <File Id="AzureActivitiesFile"
              Name="AzureActivities.dll"
              Source="$(var.PayloadSourceDir)AzureActivities.dll"
              KeyPath="yes">
          <CopyFile Id="CopyAzureActivitiesToSoup"
                    DestinationDirectory="SOUPCUSTOMLIBRARIESFOLDER" />
          <CopyFile Id="CopyAzureActivitiesToWorkflowDesigner"
                    DestinationDirectory="WORKFLOWDESIGNERCUSTOMLIBRARIESFOLDER" />
        </File>
      </Component>

      <Component Id="MicrosoftBclAsyncInterfacesComponent"
                 Guid="{9D30B5D1-0D2A-4F8B-9098-3C0A8E70C311}">
        <File Id="MicrosoftBclAsyncInterfacesFile"
              Name="Microsoft.Bcl.AsyncInterfaces.dll"
              Source="$(var.PayloadSourceDir)Microsoft.Bcl.AsyncInterfaces.dll"
              KeyPath="yes">
          <CopyFile Id="CopyMicrosoftBclAsyncInterfacesToSoup"
                    DestinationDirectory="SOUPCUSTOMLIBRARIESFOLDER" />
          <CopyFile Id="CopyMicrosoftBclAsyncInterfacesToWorkflowDesigner"
                    DestinationDirectory="WORKFLOWDESIGNERCUSTOMLIBRARIESFOLDER" />
        </File>
      </Component>

      <Component Id="SystemBuffersComponent"
                 Guid="{B8A570EF-1B5F-48AD-A1FD-91A528A1269D}">
        <File Id="SystemBuffersFile"
              Name="System.Buffers.dll"
              Source="$(var.PayloadSourceDir)System.Buffers.dll"
              KeyPath="yes">
          <CopyFile Id="CopySystemBuffersToSoup"
                    DestinationDirectory="SOUPCUSTOMLIBRARIESFOLDER" />
          <CopyFile Id="CopySystemBuffersToWorkflowDesigner"
                    DestinationDirectory="WORKFLOWDESIGNERCUSTOMLIBRARIESFOLDER" />
        </File>
      </Component>

      <Component Id="SystemConfigurationConfigurationManagerComponent"
                 Guid="{3DF8E97D-A6CF-4B2A-B1BC-B617859C5E01}">
        <File Id="SystemConfigurationConfigurationManagerFile"
              Name="System.Configuration.ConfigurationManager.dll"
              Source="$(var.PayloadSourceDir)System.Configuration.ConfigurationManager.dll"
              KeyPath="yes">
          <CopyFile Id="CopySystemConfigurationConfigurationManagerToSoup"
                    DestinationDirectory="SOUPCUSTOMLIBRARIESFOLDER" />
          <CopyFile Id="CopySystemConfigurationConfigurationManagerToWorkflowDesigner"
                    DestinationDirectory="WORKFLOWDESIGNERCUSTOMLIBRARIESFOLDER" />
        </File>
      </Component>

      <Component Id="SystemDiagnosticsDiagnosticSourceComponent"
                 Guid="{C314D6DA-E7D1-4A4A-A5D3-4D2632B77E48}">
        <File Id="SystemDiagnosticsDiagnosticSourceFile"
              Name="System.Diagnostics.DiagnosticSource.dll"
              Source="$(var.PayloadSourceDir)System.Diagnostics.DiagnosticSource.dll"
              KeyPath="yes">
          <CopyFile Id="CopySystemDiagnosticsDiagnosticSourceToSoup"
                    DestinationDirectory="SOUPCUSTOMLIBRARIESFOLDER" />
          <CopyFile Id="CopySystemDiagnosticsDiagnosticSourceToWorkflowDesigner"
                    DestinationDirectory="WORKFLOWDESIGNERCUSTOMLIBRARIESFOLDER" />
        </File>
      </Component>

      <Component Id="SystemIoHashingComponent"
                 Guid="{9AC720E7-ECC7-4DB0-AB21-5D8CB4D4D2A3}">
        <File Id="SystemIoHashingFile"
              Name="System.IO.Hashing.dll"
              Source="$(var.PayloadSourceDir)System.IO.Hashing.dll"
              KeyPath="yes">
          <CopyFile Id="CopySystemIoHashingToSoup"
                    DestinationDirectory="SOUPCUSTOMLIBRARIESFOLDER" />
          <CopyFile Id="CopySystemIoHashingToWorkflowDesigner"
                    DestinationDirectory="WORKFLOWDESIGNERCUSTOMLIBRARIESFOLDER" />
        </File>
      </Component>

      <Component Id="SystemMemoryDataComponent"
                 Guid="{8D93295E-6E6A-426F-B46D-BEF753D9CD52}">
        <File Id="SystemMemoryDataFile"
              Name="System.Memory.Data.dll"
              Source="$(var.PayloadSourceDir)System.Memory.Data.dll"
              KeyPath="yes">
          <CopyFile Id="CopySystemMemoryDataToSoup"
                    DestinationDirectory="SOUPCUSTOMLIBRARIESFOLDER" />
          <CopyFile Id="CopySystemMemoryDataToWorkflowDesigner"
                    DestinationDirectory="WORKFLOWDESIGNERCUSTOMLIBRARIESFOLDER" />
        </File>
      </Component>

      <Component Id="SystemMemoryComponent"
                 Guid="{E3A98C16-AF9D-40CA-B17B-A1A4D6B0B6CA}">
        <File Id="SystemMemoryFile"
              Name="System.Memory.dll"
              Source="$(var.PayloadSourceDir)System.Memory.dll"
              KeyPath="yes">
          <CopyFile Id="CopySystemMemoryToSoup"
                    DestinationDirectory="SOUPCUSTOMLIBRARIESFOLDER" />
          <CopyFile Id="CopySystemMemoryToWorkflowDesigner"
                    DestinationDirectory="WORKFLOWDESIGNERCUSTOMLIBRARIESFOLDER" />
        </File>
      </Component>

      <Component Id="SystemNumericsVectorsComponent"
                 Guid="{AF0CB63C-A1F7-44C2-A86F-66E2B2EFA297}">
        <File Id="SystemNumericsVectorsFile"
              Name="System.Numerics.Vectors.dll"
              Source="$(var.PayloadSourceDir)System.Numerics.Vectors.dll"
              KeyPath="yes">
          <CopyFile Id="CopySystemNumericsVectorsToSoup"
                    DestinationDirectory="SOUPCUSTOMLIBRARIESFOLDER" />
          <CopyFile Id="CopySystemNumericsVectorsToWorkflowDesigner"
                    DestinationDirectory="WORKFLOWDESIGNERCUSTOMLIBRARIESFOLDER" />
        </File>
      </Component>

      <Component Id="SystemRuntimeCompilerServicesUnsafeComponent"
                 Guid="{56B80F06-C8A2-4323-98DF-C5D6A8B0D2EF}">
        <File Id="SystemRuntimeCompilerServicesUnsafeFile"
              Name="System.Runtime.CompilerServices.Unsafe.dll"
              Source="$(var.PayloadSourceDir)System.Runtime.CompilerServices.Unsafe.dll"
              KeyPath="yes">
          <CopyFile Id="CopySystemRuntimeCompilerServicesUnsafeToSoup"
                    DestinationDirectory="SOUPCUSTOMLIBRARIESFOLDER" />
          <CopyFile Id="CopySystemRuntimeCompilerServicesUnsafeToWorkflowDesigner"
                    DestinationDirectory="WORKFLOWDESIGNERCUSTOMLIBRARIESFOLDER" />
        </File>
      </Component>

      <Component Id="SystemTextEncodingsWebComponent"
                 Guid="{2A4C1788-EFCA-446D-AE16-B8B55C4DB523}">
        <File Id="SystemTextEncodingsWebFile"
              Name="System.Text.Encodings.Web.dll"
              Source="$(var.PayloadSourceDir)System.Text.Encodings.Web.dll"
              KeyPath="yes">
          <CopyFile Id="CopySystemTextEncodingsWebToSoup"
                    DestinationDirectory="SOUPCUSTOMLIBRARIESFOLDER" />
          <CopyFile Id="CopySystemTextEncodingsWebToWorkflowDesigner"
                    DestinationDirectory="WORKFLOWDESIGNERCUSTOMLIBRARIESFOLDER" />
        </File>
      </Component>

      <Component Id="SystemTextJsonComponent"
                 Guid="{2A9A3B3C-2F12-424B-9303-27B85F5653D6}">
        <File Id="SystemTextJsonFile"
              Name="System.Text.Json.dll"
              Source="$(var.PayloadSourceDir)System.Text.Json.dll"
              KeyPath="yes">
          <CopyFile Id="CopySystemTextJsonToSoup"
                    DestinationDirectory="SOUPCUSTOMLIBRARIESFOLDER" />
          <CopyFile Id="CopySystemTextJsonToWorkflowDesigner"
                    DestinationDirectory="WORKFLOWDESIGNERCUSTOMLIBRARIESFOLDER" />
        </File>
      </Component>

      <Component Id="SystemThreadingTasksExtensionsComponent"
                 Guid="{94F2B7D5-91E6-4C85-9B29-6AFAF89DF4A7}">
        <File Id="SystemThreadingTasksExtensionsFile"
              Name="System.Threading.Tasks.Extensions.dll"
              Source="$(var.PayloadSourceDir)System.Threading.Tasks.Extensions.dll"
              KeyPath="yes">
          <CopyFile Id="CopySystemThreadingTasksExtensionsToSoup"
                    DestinationDirectory="SOUPCUSTOMLIBRARIESFOLDER" />
          <CopyFile Id="CopySystemThreadingTasksExtensionsToWorkflowDesigner"
                    DestinationDirectory="WORKFLOWDESIGNERCUSTOMLIBRARIESFOLDER" />
        </File>
      </Component>

      <Component Id="ServerServiceRestartComponent"
                 Guid="{A3290E3D-1B3F-4C17-B434-4CC2B54A6E43}"
                 Condition="INTEGRATIONSOUPSERVICEFOUND">
        <RegistryValue Root="HKLM"
                       Key="Software\Popokey\AzureActivities"
                       Name="ServiceRestartMarker"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <ServiceControl Id="RestartIntegrationSoupHostService"
                        Name="IntegrationSoupHostService"
                        Stop="both"
                        Start="install"
                        Wait="yes" />
      </Component>

      <Component Id="LegacyServerServiceRestartComponent"
                 Guid="{ED5C10C4-40EA-453D-8143-466516B2AD93}"
                 Condition="LEGACYINTEGRATIONSOUPSERVICEFOUND">
        <RegistryValue Root="HKLM"
                       Key="Software\Popokey\AzureActivities"
                       Name="LegacyServiceRestartMarker"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <ServiceControl Id="RestartLegacyIntegrationSoupHostService"
                        Name="HL7SoupIntegrationHostServer"
                        Stop="both"
                        Start="install"
                        Wait="yes" />
      </Component>
    </DirectoryRef>

  </Package>
</Wix>
