<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AzureActivitiesRunner</AssemblyName>
    <RootNamespace>AzureActivities.Runner</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ExtensionRunnerHosting\*.cs" Link="ExtensionRunnerHosting\%(Filename)%(Extension)" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.14.0" />
  </ItemGroup>

  <PropertyGroup><BridgeAdapterSource>$(MSBuildProjectDirectory)/../AzureActivities/AzureActivities</BridgeAdapterSource></PropertyGroup>
  <Import Project="../ExtensionBridgeRuntime/ExtensionBridgeRuntime.targets" />
</Project>
