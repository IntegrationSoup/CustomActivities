<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HtmlToPdfRenderer</AssemblyName>
    <RootNamespace>HtmlToPdfActivities.Renderer</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ExtensionRunnerHosting\*.cs" Link="ExtensionRunnerHosting\%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup><BridgeAdapterSource>$(MSBuildProjectDirectory)/../HtmlToPdfActivities</BridgeAdapterSource></PropertyGroup>
  <Import Project="../ExtensionBridgeRuntime/ExtensionBridgeRuntime.targets" />
</Project>
