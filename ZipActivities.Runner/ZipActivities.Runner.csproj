<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ZipActivitiesRunner</AssemblyName>
    <RootNamespace>ZipActivities.Runner</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ExtensionRunnerHosting\*.cs" Link="ExtensionRunnerHosting\%(Filename)%(Extension)" />
    <Reference Include="System.IO.Compression" Condition="'$(TargetFramework)' == 'net48'" />
    <Reference Include="System.IO.Compression.FileSystem" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>

  <PropertyGroup><BridgeAdapterSource>$(MSBuildProjectDirectory)/../ZipActivities</BridgeAdapterSource></PropertyGroup>
  <Import Project="../ExtensionBridgeRuntime/ExtensionBridgeRuntime.targets" />
</Project>
